# Build image for BOTH static frontends (website or admin), selected by the
# ARG APP. Like the API image it is two-stage: build with Vite in stage 1,
# then serve the produced dist/ from a stock Caddy image in stage 2.

# ---- Stage 1: install dependencies and run the Vite build ------------------
FROM node:22-bookworm-slim AS build
WORKDIR /app
# Which workspace to build: 'website' or 'admin' (set by compose.yml).
ARG APP=website
# Build-time variables baked into the bundle (public URLs, never secrets).
ARG VITE_ADMIN_URL
ARG VITE_WEBSITE_URL
ENV VITE_ADMIN_URL=$VITE_ADMIN_URL
ENV VITE_WEBSITE_URL=$VITE_WEBSITE_URL
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/website/package.json apps/website/package.json
COPY apps/admin/package.json apps/admin/package.json
RUN npm ci
COPY apps/shared apps/shared
COPY apps/website apps/website
COPY apps/admin apps/admin
RUN npm run build -w @testimonials/${APP} && mkdir /out && cp -r apps/${APP}/dist/. /out/

# ---- Stage 2: tiny Caddy image that just serves the static files -----------
FROM caddy:2-alpine
COPY deploy/static.Caddyfile /etc/caddy/Caddyfile
COPY --from=build /out /srv
EXPOSE 8080