# Build image for the Express API. Two-stage: compile in the first stage, then
# copy ONLY the compiled output into a slimmer runtime image, so production
# ships without the source, TypeScript compiler, or other dev dependencies.

# ---- Stage 1: install everything and compile to dist/ ---------------------
FROM node:22-bookworm-slim AS build
WORKDIR /app
# Copy manifests first: Docker layer caching means `npm ci` only re-runs when
# the manifests change, not on every code edit.
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/website/package.json apps/website/package.json
COPY apps/admin/package.json apps/admin/package.json
RUN npm ci
COPY apps/api apps/api
# Build then drop dev dependencies: the output works with production deps only.
RUN npm run build -w @testimonials/api && npm prune --omit=dev

# ---- Stage 2: minimal runtime image ---------------------------------------
FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/package.json ./package.json
COPY --from=build /app/apps/api/dist ./dist
# Upload directory owned by the non-root `node` user it runs as.
RUN mkdir -p /app/uploads && chown node:node /app/uploads
# Danger: Dockerfiles support comments ONLY on their own lines — an inline `#`
# becomes part of the instruction's argument (`USER node # comment` would look
# for a user literally named "node # comment"). Always keep comments separate.
USER node
EXPOSE 3000
CMD ["node", "dist/server.js"]