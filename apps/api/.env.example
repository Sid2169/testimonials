NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=testimonials
DB_PASSWORD=replace-with-a-long-database-password
DB_NAME=testimonials
# Use true for TiDB Cloud and other managed databases that require TLS.
DB_SSL=false
PUBLIC_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# Required only when STORAGE_DRIVER=s3 (for example, Backblaze B2).
# S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# S3_REGION=us-east-005
# S3_BUCKET=siddhartha-testimonials
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# 0 locally; 1 behind the single bundled Caddy reverse proxy.
TRUST_PROXY_HOPS=0
