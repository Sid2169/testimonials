# Production .env for docker compose (the compose.yml file reads this).
# Copy to .env next to compose.yml, fill in real values, keep it private (600).
PUBLIC_DOMAIN=words.example.com
ADMIN_DOMAIN=admin.example.com
DB_PASSWORD=replace-with-a-long-unique-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password